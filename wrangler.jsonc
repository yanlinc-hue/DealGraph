{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dealgraph",
  "main": "server/worker.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "APP_ORIGIN": "https://dealgraph.YOUR_SUBDOMAIN.workers.dev" },
  "observability": { "enabled": false },
  "logpush": false,
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "309092601", "simple": { "limit": 6, "period": 60 } },
    { "name": "GLOBAL_LIMIT", "namespace_id": "309092602", "simple": { "limit": 60, "period": 60 } }
  ]
}
